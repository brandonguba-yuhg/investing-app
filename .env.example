# Pick ONE of the two providers below.

# Option 1 (recommended): point at your own backend (yahoo-finance2 + cache).
# Runs locally on :3001 when you `npm run dev` in the server/ folder.
VITE_API_BASE_URL=http://localhost:3001

# Option 2 (fallback): use Financial Modeling Prep directly from the browser.
# Easier for solo dev, but key is exposed and tier caps at 250 calls/day.
# VITE_FMP_API_KEY=your_fmp_api_key_here
