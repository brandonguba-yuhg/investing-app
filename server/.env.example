# Comma-separated list of allowed CORS origins for production (your Vercel URL).
# localhost is always allowed.
ALLOWED_ORIGINS=https://your-app.vercel.app

# Claude API key — powers AI analysis + market briefing.
ANTHROPIC_API_KEY=sk-ant-...

# Financial Modeling Prep key — fallback data source when Yahoo blocks the IP.
FMP_API_KEY=your_fmp_key

# Optional: override default port 3001
# PORT=3001

# Daily briefing provider. "free" (default) costs nothing: index closes from FRED +
# Nasdaq.com, news from public RSS feeds, prose by Gemini's free tier (or a plain
# template if GEMINI_API_KEY is unset). "claude" uses Claude + paid web search.
# BRIEFING_PROVIDER=free

# Optional, free: Google AI Studio key (aistudio.google.com/apikey, no billing) so
# Gemini writes the briefing prose. Without it, a deterministic template is used.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest,gemini-flash-lite-latest  (tried in order)

# Optional (BRIEFING_PROVIDER=claude only): override the briefing model (default: claude-sonnet-4-6).
# Point this at a model that won't call web_search to force a SEARCH_NOT_EXECUTED
# rejection when smoke-testing the failure path.
# BRIEFING_MODEL=

# Optional: absolute path for the accepted-briefing JSON cache (default: os.tmpdir()).
# BRIEFING_CACHE_PATH=

# Optional: absolute path for the append-only rejected-run log (default: os.tmpdir()).
# BRIEFING_FAILURES_PATH=
